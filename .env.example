# Copy this file to .env and fill it in. Never commit .env.
# Supabase dashboard > Project Settings > API Keys (URL is under Data API).
# Leave both empty to keep everything in the local SQLite file instead.
SUPABASE_URL=
# The PUBLIC key ("publishable", starts sb_publishable_, or the legacy "anon" key)
SUPABASE_ANON_KEY=
# The SECRET key. Only used on your laptop by `python -m app.supabase.seed`.
# Never put it on the web server.
SUPABASE_SECRET_KEY=
# 1 = fake ID function (default), 0 = Person A's real identify()
USE_FAKE_ID=1
